---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  mode: "mobile" | "desktop";
}
const { headings, mode } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
const visibleItems = mode === "desktop" ? items.filter(({ depth }) => depth === 2) : items;
---

{
  items.length > 0 && (
    mode === "mobile" ? (
      <details class="toc-mobile">
        <summary>目次</summary>
        <nav aria-label="記事の目次">
          <ol>
            {visibleItems.map((heading) => (
              <li class:list={[`depth-${heading.depth}`]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ) : (
      <aside class="toc-desktop">
        <p>目次</p>
        <nav aria-label="記事の目次">
          <ol>
            {visibleItems.map((heading) => (
              <li class:list={[`depth-${heading.depth}`]}>
                <a href={`#${heading.slug}`} data-toc-link data-toc-depth={heading.depth}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )
  )
}

<script>
  for (const summary of document.querySelectorAll<HTMLElement>(".toc-mobile summary")) {
    summary.addEventListener("pointerdown", () => {
      summary.dataset.pointerFocus = "";
    });
    summary.addEventListener("blur", () => {
      delete summary.dataset.pointerFocus;
    });
  }

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  const sectionIds = [...new Set(links.map((link) => decodeURIComponent(link.hash.slice(1))))];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => Boolean(section));
  let ticking = false;

  const updateCurrentSection = () => {
    ticking = false;
    let current = sections[0];
    let currentPrimary = sections.find((section) => section.tagName === "H2");
    for (const section of sections) {
      if (section.getBoundingClientRect().top > 160) break;
      current = section;
      if (section.tagName === "H2") currentPrimary = section;
    }
    for (const link of links) {
      const target = link.closest(".toc-desktop") ? currentPrimary : current;
      const active = target && decodeURIComponent(link.hash.slice(1)) === target.id;
      if (active) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  };

  addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateCurrentSection);
    },
    { passive: true },
  );
  updateCurrentSection();
</script>

<style>
  .toc-desktop {
    align-self: start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    font-size: 0.875rem;
    padding: 0.875rem 0.75rem;
    position: sticky;
    top: 6rem;
  }
  .toc-desktop p {
    color: var(--text);
    font-weight: 700;
    margin: 0 0 0.6rem;
  }
  ol {
    border-left: 1px solid var(--border);
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.85rem;
  }
  li {
    line-height: 1.5;
    margin: 0.5rem 0;
  }
  li.depth-3 {
    padding-left: 0.65rem;
  }
  a {
    border-radius: 0.3rem;
    color: var(--muted);
    display: block;
    padding: 0.12rem 0.3rem;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  a[aria-current="location"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    box-shadow: inset 3px 0 0 var(--accent);
    color: var(--accent);
    font-weight: 700;
    padding-left: 0.55rem;
  }
  .toc-mobile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.45rem;
    display: block;
    margin: 1.5rem 0 2rem;
    padding: 0.75rem 1rem;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 2.75rem;
    padding-top: 0.45rem;
  }
  summary[data-pointer-focus]:focus-visible {
    outline: none;
  }
  @media (max-width: 72rem) {
    .toc-desktop {
      display: none;
    }
  }
</style>
