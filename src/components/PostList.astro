---
import type { Post } from "../lib/posts";
import { formatDate, formatIsoDate, postPath } from "../lib/posts";

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <div class="meta">
            <time datetime={formatIsoDate(post.data.published)}>
              {formatDate(post.data.published)}
            </time>
            {post.data.categories.map((category) => (
              <a href={`/category/${category}`}>{category}</a>
            ))}
          </div>
          <h2><a href={postPath(post)}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
        </article>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-top: 1px solid var(--border);
    padding: 1.7rem 0;
  }
  li:first-child {
    border-top: 0;
  }
  h2 {
    border: 0;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    margin: 0.45rem 0 0.65rem;
    padding: 0;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.75;
    margin: 0;
  }
  .meta {
    align-items: center;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 0.5rem;
  }
  .meta a {
    background: var(--surface);
    border-radius: 2rem;
    padding: 0.08rem 0.5rem;
    text-decoration: none;
  }
</style>
