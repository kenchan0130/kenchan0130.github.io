---
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
  return categories.map((category) => ({
    params: { category },
    props: { posts: posts.filter((post) => post.data.categories.includes(category)) },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout
  title={`Category: ${category}`}
  description={`${category}カテゴリの記事一覧です。`}
>
  <div class="container category">
    <p class="back"><a href="/archives">← Archives</a></p>
    <h1>{category}</h1>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  .category {
    max-width: 52rem;
  }
  .back {
    font-size: 0.82rem;
    margin: 0 0 1rem;
  }
</style>
