---
import PostList from "../components/PostList.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    author: { "@type": "Person", name: SITE.author },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.author,
    url: `${SITE.url}/profile`,
    sameAs: [SITE.profiles.github, SITE.profiles.x],
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container home">
    <header>
      <p class="eyebrow">{SITE.subtitle}</p>
      <h1>{SITE.title}</h1>
      <p class="lead">
        <span>{SITE.introduction}</span>
        <span>{SITE.disclaimer}</span>
      </p>
    </header>
    <section aria-labelledby="latest">
      <h2 id="latest">Latest posts</h2>
      <PostList posts={posts.slice(0, 10)} />
      <a class="more" href="/archives">すべての記事を見る</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    padding-top: 1.5rem;
  }
  header {
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0 3rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 3.25rem);
    letter-spacing: -0.055em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .lead {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 43rem;
    margin-bottom: 0;
  }
  .lead span {
    display: block;
  }

  .lead span + span {
    margin-top: 0.3rem;
  }
  section {
    padding-top: 2.5rem;
  }
  section > h2 {
    font-size: 1rem;
    letter-spacing: 0.08em;
    margin-top: 0;
    text-transform: uppercase;
  }
  .more {
    display: inline-block;
    font-weight: 700;
    margin-top: 1.5rem;
  }
</style>
