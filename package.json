{
  "name": "kenchan0130.github.io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "prebuild": "pnpm og && pnpm optimize:images",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --force-language ja",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && pnpm lint:content && pnpm lint:text",
    "lint:content": "node scripts/validate-content.mjs",
    "lint:text": "textlint --format pretty-error \"src/content/posts/**/*.{md,mdx}\"",
    "migrate:content": "node scripts/migrate-content.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:build": "node scripts/verify-generated-output.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "refresh:link-cards": "node scripts/refresh-link-cards.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm verify:build && pnpm test:e2e",
    "audit": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@lucide/astro": "1.27.0",
    "astro": "7.2.8",
    "astro-d2": "0.14.0",
    "astro-expressive-code": "0.44.1",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "open-graph-scraper": "6.12.0",
    "pagefind": "1.5.2",
    "satori": "0.29.0",
    "satori-html": "0.3.2",
    "sharp": "0.35.4",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@d2lang/d2": "0.1.34",
    "@playwright/test": "1.62.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@textlint/textlint-plugin-markdown": "15.7.1",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "gray-matter": "4.0.3",
    "textlint": "15.7.1",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-no-nfd": "2.0.2",
    "textlint-rule-preset-ja-spacing": "3.0.2",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "trustPolicy": "no-downgrade",
    "blockExoticSubdeps": true,
    "strictDepBuilds": true,
    "allowBuilds": {
      "@biomejs/biome@2.5.5": true,
      "esbuild@0.28.1": true,
      "sharp@0.35.3": true
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    }
  }
}
